# Bolder Intranet — environment variables
# Copy to .env (gitignored) and fill in.

# ----- Database -----
# Path to the SQLite file (relative to apps/api cwd by default)
DATABASE_URL=./data/app.db

# ----- Backend (apps/api) -----
API_PORT=3001
# JWT secret used by the Hono backend for its own session/cookie signing
JWT_SECRET=replace-me-with-a-long-random-string

# ----- Auth.js (apps/web) -----
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
# Where Auth.js talks to the backend to verify credentials
API_URL=http://localhost:3001

# ----- Frontend (apps/web) -----
# Same as API_URL but exposed to the browser for the Hono RPC client
NEXT_PUBLIC_API_URL=http://localhost:3001