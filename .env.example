# Bolder Intranet — environment variables
# Copy this file to `.env` (gitignored) and fill in the placeholders.
# This file is the single source of truth: apps/web/next.config.ts loads
# it from the repo root, and apps/api/src/env.ts pulls it via dotenv.

# ----- Database -----
# Path to the SQLite file (relative to apps/api cwd when running via pnpm).
# The directory is created automatically on first run.
DATABASE_URL=./data/app.db

# ----- Backend (apps/api) -----
# Port the Hono server listens on.
API_PORT=3001
# Secret used to sign HS256 JWT session tokens. Generate with:
#   openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string

# ----- Auth.js (apps/web) -----
# Secret used by Auth.js to sign/encrypt JWTs and CSRF tokens. Generate
# with `openssl rand -base64 32`. MUST differ from JWT_SECRET in production.
AUTH_SECRET=replace-me-with-a-long-random-string
# Public origin of the frontend. Used for callback URLs and CSRF checks.
NEXTAUTH_URL=http://localhost:3000
# Where Auth.js talks to the backend to verify credentials.
API_URL=http://localhost:3001

# ----- Frontend (apps/web) -----
# Same as API_URL but exposed to the browser for the Hono RPC client.
NEXT_PUBLIC_API_URL=http://localhost:3001
